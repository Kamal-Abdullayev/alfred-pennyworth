# Copy this file to .env and fill in real values:  cp .env.example .env
# .env is gitignored and never committed. runner.py loads it at startup and the
# MCP server subprocesses inherit these variables from the environment.

# On-prem GitLab MCP server (mcp_servers/gitlab/server.py)
GITLAB_URL=https://gitlab.ballys.tech
GITLAB_TOKEN=your_personal_access_token_with_read_api_scope

# Optional: set only if you hit an SSL verification error against the internal CA
# GITLAB_CA_BUNDLE=/path/to/internal-ca.pem

# Optional: where the GitLab server writes its own debug logs
# GITLAB_LOG_DIR=/Users/kamal.abdullayev/Desktop/mcp-server-logs/
